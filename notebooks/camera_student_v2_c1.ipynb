   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Comparison: teacher vs old student vs new student\n",
    "\n",
    "The teacher row comes from your curriculum evaluation of C1_a3, restricted to 125\u2013185 mm, so it needs no extra run."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "T = dict(np.load(f\"{DRIVE_ROOT}/curriculum/eval_C1_a3_R51.npz\"))\n",
    "r = np.hypot(T[\"xy\"][:, 0], T[\"xy\"][:, 1]) * 1000; th = np.degrees(np.arctan2(T[\"xy\"][:, 1], T[\"xy\"][:, 0]))\n",
    "keep = r <= 185                                   # the C1 eval also had 185-195 mm spawns; drop them\n",
    "def tgrp(g): m = keep & (T[\"group\"] == g); return T[\"success\"][m].mean()\n",
    "def tband(lo): m = keep & (T[\"group\"] == 2) & (th >= lo) & (th < lo + 10); return T[\"success\"][m].mean()\n",
    "rows = {\"teacher C1_a3\": {\"nominal\": tgrp(0), \"retention\": tgrp(1), \"sector\": tgrp(2),\n",
    "                          **{lo: tband(lo) for lo in (50, 60, 70)}, \"egg_err\": None}}\n",
    "for name, f in ((\"old student\", f\"{STU}/eval_old_student_none.json\"), (\"new student\", f\"{STU}/eval_student_c1_none.json\")):\n",
    "    d = json.load(open(f)); b = {x[\"theta\"]: x[\"success\"] for x in d[\"by_angle\"]}\n",
    "    rows[name] = {\"nominal\": d[\"groups\"][\"nominal\"][\"success\"], \"retention\": d[\"groups\"][\"retention\"][\"success\"],\n",
    "                  \"sector\": d[\"groups\"][\"sector\"][\"success\"], **{lo: b.get(lo, float(\"nan\")) for lo in (50, 60, 70)},\n",
    "                  \"egg_err\": d[\"egg_err_mm\"]}\n",
    "print(f\"{'C1 region':14s} {'nominal':>8s} {'retention':>10s} {'sector':>7s} {'50-60':>6s} {'60-70':>6s} {'70-80':>6s} {'egg err':>8s}\")\n",
    "for name, v in rows.items():\n",
    "    e = \"-\" if v[\"egg_err\"] is None else f\"{v['egg_err']:.1f} mm\"\n",
    "    print(f\"{name:14s} {v['nominal']:8.0%} {v['retention']:10.0%} {v['sector']:7.0%} {v[50]:6.0%} {v[60]:6.0%} {v[70]:6.0%} {e:>8s}\")"
   ]
