# SpiRob vision settings, used by setup.sh, run.sh and notebooks/model_pipeline.ipynb.
# One KEY=value per line. $HOME is allowed. Comments only on their own lines.

# sir's simulation repo, and the branch to clone if it is not there yet
SIR_REPO=$HOME/spirob-mjlab
SIR_BRANCH=research/s2-spawn-randomization

# where all outputs go; MODEL_TAG names the robot model being tested (outputs go to RUNS/MODEL_TAG)
RUNS=$HOME/spirob_runs
MODEL_TAG=old_model

# robots simulated in parallel (T4: 256; larger GPUs: 512-1024)
NUM_ENVS_TRAIN=512
NUM_ENVS_EVAL=512
